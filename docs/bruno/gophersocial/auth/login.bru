meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "alice",
    "password": "Password123!"
  }
}

script:post-response {
  bru.setVar("token", res.body.data.access_token);
  bru.setVar("refreshToken", res.body.data.refresh_token);
}
