meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.data.access_token);
  bru.setVar("refreshToken", res.body.data.refresh_token);
}
