meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "zoe",
    "email": "zoe@example.com",
    "password": "Password123!",
    "display_name": "Zoe"
  }
}

script:post-response {
  bru.setVar("token", res.body.data.access_token);
  bru.setVar("refreshToken", res.body.data.refresh_token);
}
