# Copy to .env for local development: cp .env.example .env
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# PostgreSQL
# Uses the PostgreSQL already running on localhost:5432.
# Databases that do not exist yet are created on first connection.
DATABASE_URL=postgresql://admin:password@localhost:5432/gopherdb
DATABASE_MAX_CONNS=10

# Authentication. Generate a real secret with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
JWT_ISSUER=gophersocial
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# HTTP behaviour
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576
READINESS_TIMEOUT=2s

# Auth endpoint rate limit (per client IP, fixed window)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m

# Notification worker
NOTIFICATION_QUEUE_SIZE=256
NOTIFICATION_WORKERS=2
